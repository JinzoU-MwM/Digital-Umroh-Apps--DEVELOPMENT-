# Environment variables for Docker Compose
# Copy this file to .env and update the values

# Application Configuration
NODE_ENV=production
API_PORT=3001
WORKER_PORT=3002
WEB_PORT=3000

# Database Configuration
POSTGRES_DB=digital_umroh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-256-bits
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-key

# Frontend Configuration
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com
CORS_ORIGIN=https://your-domain.com

# Storage Configuration (Cloudflare R2)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
S3_BUCKET=digital-umroh-storage

# Payment Gateway Configuration
XENDIT_API_KEY=xnd_production_*
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# WhatsApp Integration (WAHA)
WAHA_URL=http://waha:5000
WAHA_API_KEY=your-waha-api-key
WAHA_WEBHOOK_URL=http://api:3001/api/v1/webhooks/whatsapp
WAHA_ENGINE=NOWEB

# Email Configuration
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your-postmark-token
SMTP_PASS=your-postmark-token
EMAIL_FROM=noreply@your-domain.com

# Admin UI Configuration
PGADMIN_EMAIL=admin@your-domain.com
PGADMIN_PASSWORD=your-secure-pgadmin-password
PGADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081
WAHA_PORT=5000

# Logging Configuration
LOG_LEVEL=info

# SSL Configuration (for production)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem