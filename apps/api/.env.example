# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_umroh?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
OTP_SECRET=your-super-secret-otp-key

# Storage (Cloudflare R2)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=digital-umroh
S3_REGION=auto

# Email
SMTP_HOST=smtp.postmark.com
SMTP_PORT=587
SMTP_USER=your-postmark-token
SMTP_PASS=your-postmark-token
EMAIL_FROM=noreply@your-domain.com

# WhatsApp (WAHA)
WAHA_URL=http://localhost:5000
WAHA_API_KEY=your-waha-api-key

# Payment Gateways
XENDIT_API_KEY=xnd_development_*
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info